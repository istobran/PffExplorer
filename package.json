{
  "name": "pff-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "subset:fonts": "node scripts/subset-chinese-font.mjs",
    "predev": "pnpm subset:fonts",
    "dev": "vite",
    "prebuild": "pnpm subset:fonts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build:windows-msvc": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --no-bundle",
    "tauri:build:windows-msvc:debug": "tauri build --debug --runner cargo-xwin --target x86_64-pc-windows-msvc --no-bundle"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "subset-font": "^2.5.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
